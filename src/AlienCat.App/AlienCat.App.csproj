<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AlienCat</AssemblyName>
    <RootNamespace>AlienCat.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Космокот</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlienCat.Core\AlienCat.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\animations.json" LogicalName="animations.json" />
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>
</Project>
